From 7e42157ca4b59c95cc56ee4c47a5fad64101890c Mon Sep 17 00:00:00 2001
From: Berkant Bakisli <berkant.bakisli@gmail.com>
Date: Fri, 24 Jul 2026 01:15:47 +0100
Subject: [PATCH 2/2] debug: trace NVDLA CSB register reads

---
 kmd/port/linux/nvdla_core_callbacks.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/kmd/port/linux/nvdla_core_callbacks.c b/kmd/port/linux/nvdla_core_callbacks.c
index e9554eb..e8396c3 100644
--- a/kmd/port/linux/nvdla_core_callbacks.c
+++ b/kmd/port/linux/nvdla_core_callbacks.c
@@ -321,11 +321,21 @@ uint32_t dla_reg_read(void *driver_context, uint32_t addr)
 {
 	struct nvdla_device *nvdla_dev =
 			(struct nvdla_device *)driver_context;
+	uint32_t value;
 
 	if (!nvdla_dev)
 		return 0;
 
-	return readl(nvdla_dev->base + addr);
+#ifdef NVDLA_KMD_TRACE
+	pr_info("nvdla-trace csb-read begin offset=0x%08x\n", addr);
+#endif
+	value = readl(nvdla_dev->base + addr);
+#ifdef NVDLA_KMD_TRACE
+	pr_info("nvdla-trace csb-read end offset=0x%08x value=0x%08x\n",
+		addr, value);
+#endif
+
+	return value;
 }
 
 static irqreturn_t nvdla_engine_isr(int32_t irq, void *data)
-- 
2.34.1

