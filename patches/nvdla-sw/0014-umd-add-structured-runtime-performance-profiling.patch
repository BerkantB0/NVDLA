     TestAppArgs() :
         inputPath("./"),
@@ -56,7 +107,10 @@ struct TestAppArgs
         serverPort(6666),
         normalize_value(1),
         mean{0.0, 0.0, 0.0, 0.0},
-        rawOutputDump(false)
+        rawOutputDump(false),
+        profilePath(""),
+        warmupIterations(0),
+        measuredIterations(1)
     {}
 };
 
@@ -74,7 +128,8 @@ struct TestInfo
         numInputs(0),
         numOutputs(0),
         inputImage(NULL),
-        outputImage(NULL)
+        outputImage(NULL),
+        profile()
     {}
     // runtime
     nvdla::IRuntime* runtime;
@@ -89,6 +144,7 @@ struct TestInfo
     NvU32 numOutputs;
