From ce7329cd2b1caa47bb5cb1635222063cc07c24f1 Mon Sep 17 00:00:00 2001
From: Berkant Bakisli <berkant.bakisli@gmail.com>
Date: Sun, 26 Jul 2026 17:18:48 +0100
Subject: [PATCH 15/17] kmd: make firmware progress logging opt-in

The firmware emits a large volume of debug and operation progress text from interrupt and submission paths. This can dominate host-observed latency on serial consoles and obscures production performance.

Add a firmware_log module parameter, disabled by default, at the Linux logging callback boundary. It gates only dla_debug() and dla_info(); warnings, errors, probe diagnostics, scheduling, DMA, register access, and the public ABI remain unchanged.

Signed-off-by: Berkant Bakisli <berkant.bakisli@gmail.com>
---
 kmd/port/linux/nvdla_core_callbacks.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/kmd/port/linux/nvdla_core_callbacks.c b/kmd/port/linux/nvdla_core_callbacks.c
index 7ab9710..bd84bf4 100644
--- a/kmd/port/linux/nvdla_core_callbacks.c
+++ b/kmd/port/linux/nvdla_core_callbacks.c
@@ -61,6 +61,11 @@
 #include <nvdla_linux.h>
 #include <nvdla_ioctl.h>
 
+static bool firmware_log;
+module_param(firmware_log, bool, 0644);
+MODULE_PARM_DESC(firmware_log,
+		 "enable NVDLA firmware debug and progress messages");
+
 static struct nvdla_config nvdla_config_os_initial = {
 	.atom_size = 32,
 	.bdma_enable = true,
@@ -145,6 +150,10 @@ static int nvdla_enable_clocks(struct nvdla_device *nvdla_dev)
 void dla_debug(const char *str, ...)
 {
 	va_list args;
+
+	if (!READ_ONCE(firmware_log))
+		return;
+
 	va_start(args, str);
 	vprintk(pr_fmt(str), args);
 	va_end(args);
@@ -153,6 +162,10 @@ void dla_debug(const char *str, ...)
 void dla_info(const char *str, ...)
 {
 	va_list args;
+
+	if (!READ_ONCE(firmware_log))
+		return;
+
 	va_start(args, str);
 	vprintk(str, args);
 	va_end(args);
