+static NvDlaError runStreamIterations(
+    const TestAppArgs* appArgs,
+    TestInfo* i,
+    void* pInputBuffer,
+    void* pOutputBuffer,
+    NvU32 totalIterations,
+    std::vector<std::vector<NvU8> >* referenceOutputs)
+{
+    NvDlaError e = NvDlaSuccess;
+    nvdla::IRuntime::NvDlaTensor tensorDesc;
+    StreamQueue queue;
+    std::thread producer;
+    NvU64 measuredStart = 0;
+
+    PROPAGATE_ERROR_FAIL(i->runtime->getInputTensorDesc(0, &tensorDesc));
+    producer = std::thread(produceStreamFrames, appArgs, tensorDesc,
+                           totalIterations, &queue);
+
+    for (NvU32 index = 0; index < totalIterations; ++index)
+    {
+        StreamFrame frame;
+        PerformanceSample sample;
+        NvU64 phaseStart;
+
+        if (index == appArgs->warmupIterations)
+            measuredStart = monotonicRawNs();
+        phaseStart = monotonicRawNs();
+
+        {
+            std::unique_lock<std::mutex> lock(queue.mutex);
+            queue.readable.wait(lock, [&queue] {
+                return !queue.frames.empty() || queue.finished;
+            });
+            sample.queueWaitNs = elapsedNs(phaseStart);
+            if (queue.frames.empty())
+                ORIGINATE_ERROR_FAIL(queue.status == NvDlaSuccess ?
+                                         NvDlaError_BadParameter : queue.status,
+                                     "input stream ended before frame %u",
+                                     index + 1);
+            frame = queue.frames.front();
+            queue.frames.pop_front();
+        }
+        queue.writable.notify_one();
+
+        sample.index = index + 1;
+        sample.inputIndex = appArgs->streamPeriod == 0 ?
+                                index : index % appArgs->streamPeriod;
+        sample.warmup = index < appArgs->warmupIterations;
+        sample.sourceReadNs = frame.sourceReadNs;
+        sample.inputPrepareNs = frame.inputPrepareNs;
+        if (frame.input.size() != tensorDesc.bufferSize)
+            ORIGINATE_ERROR_FAIL(NvDlaError_BadParameter,
+                                 "prepared frame size does not match input tensor");
+
+        phaseStart = monotonicRawNs();
+        memcpy(pInputBuffer, &frame.input[0], frame.input.size());
+        sample.inputUpdateNs = elapsedNs(phaseStart);
+
+        phaseStart = monotonicRawNs();
+        if (!i->runtime->submit())
+            ORIGINATE_ERROR_FAIL(NvDlaError_BadParameter,
+                                 "runtime->submit() failed");
+        sample.runtimeExecutionNs = elapsedNs(phaseStart);
+
+        phaseStart = monotonicRawNs();
+        PROPAGATE_ERROR_FAIL(DlaBuffer2DIMG(&pOutputBuffer, i->outputImage));
+        sample.outputExtractNs = elapsedNs(phaseStart);
+
+        {
+            const NvU8* outputBytes =
+                static_cast<const NvU8*>(i->outputImage->m_pData);
+            std::vector<NvU8>& referenceOutput =
+                (*referenceOutputs)[sample.inputIndex];
+            if (referenceOutput.empty())
+            {
+                referenceOutput.assign(
+                    outputBytes, outputBytes + i->outputImage->m_meta.size);
+            }
+            else if (referenceOutput.size() != i->outputImage->m_meta.size ||
+                     memcmp(&referenceOutput[0], outputBytes,
+                            referenceOutput.size()) != 0)
+            {
+                i->profile.outputsConsistent = false;
+            }
+        }
+        i->profile.samples.push_back(sample);
+    }
+    if (measuredStart != 0)
+        i->profile.streamPipelineNs = elapsedNs(measuredStart);
+
+fail:
+    {
+        std::lock_guard<std::mutex> lock(queue.mutex);
+        queue.stopped = true;
+    }
+    queue.writable.notify_all();
+    if (producer.joinable())
+        producer.join();
+    return e;
+}
