+struct StreamFrame
+{
+    NvU32 index;
+    NvU64 sourceReadNs;
+    NvU64 inputPrepareNs;
+    std::vector<NvU8> input;
+};
+
+struct StreamQueue
+{
+    StreamQueue() : stopped(false), finished(false), status(NvDlaSuccess) {}
+
+    std::deque<StreamFrame> frames;
+    std::mutex mutex;
+    std::condition_variable readable;
+    std::condition_variable writable;
+    bool stopped;
+    bool finished;
+    NvDlaError status;
+};
+
+static bool readFrame(FILE* input, std::vector<NvU8>* frame)
+{
+    size_t offset = 0;
+
+    while (offset < frame->size())
+    {
+        size_t count = fread(&(*frame)[offset], 1, frame->size() - offset,
+                             input);
+        if (count == 0)
+            return false;
+        offset += count;
+    }
+    return true;
+}
+
+static NvDlaError prepareRawFrame(const TestAppArgs* appArgs,
+                                  const std::vector<NvU8>& sourceBytes,
+                                  const nvdla::IRuntime::NvDlaTensor* tensorDesc,
+                                  std::vector<NvU8>* preparedInput)
+{
+    NvDlaError e = NvDlaSuccess;
+    NvDlaImage sourceImage;
+    NvDlaImage tensorImage;
+
+    memset(&sourceImage, 0, sizeof(sourceImage));
+    memset(&tensorImage, 0, sizeof(tensorImage));
+    if (tensorDesc->dims.c != 1 && tensorDesc->dims.c != 3)
+        ORIGINATE_ERROR_FAIL(NvDlaError_NotSupported,
+                             "raw input stream requires 1 or 3 channels");
+    sourceImage.m_meta.surfaceFormat = tensorDesc->dims.c == 1 ?
+                                           NvDlaImage::T_R8 :
+                                           NvDlaImage::T_B8G8R8;
+    sourceImage.m_meta.width = tensorDesc->dims.w;
+    sourceImage.m_meta.height = tensorDesc->dims.h;
+    sourceImage.m_meta.channel = tensorDesc->dims.c;
+    sourceImage.m_meta.lineStride = tensorDesc->dims.w * tensorDesc->dims.c;
+    sourceImage.m_meta.surfaceStride = 0;
+    sourceImage.m_meta.size = sourceBytes.size();
+    sourceImage.m_pData = const_cast<NvU8*>(&sourceBytes[0]);
+
+    PROPAGATE_ERROR_FAIL(createImageCopy(appArgs, &sourceImage, tensorDesc,
+                                         &tensorImage));
+    preparedInput->assign(static_cast<NvU8*>(tensorImage.m_pData),
+                          static_cast<NvU8*>(tensorImage.m_pData) +
+                              tensorImage.m_meta.size);
+
+fail:
+    if (tensorImage.m_pData != NULL)
+        NvDlaFree(tensorImage.m_pData);
+    return e;
+}
+
+static void produceStreamFrames(const TestAppArgs* appArgs,
+                                nvdla::IRuntime::NvDlaTensor tensorDesc,
+                                NvU32 frameCount,
+                                StreamQueue* queue)
+{
+    const size_t frameSize = tensorDesc.dims.w * tensorDesc.dims.h *
+                             tensorDesc.dims.c;
+    FILE* input = fopen(appArgs->inputStream.c_str(), "rb");
+    NvDlaError status = NvDlaSuccess;
+
+    if (input != NULL)
+    {
+        for (NvU32 index = 0; index < frameCount; ++index)
+        {
+            StreamFrame frame;
+            std::vector<NvU8> sourceBytes(frameSize);
+            NvU64 phaseStart = monotonicRawNs();
+
+            frame.index = index;
+            if (!readFrame(input, &sourceBytes))
+            {
+                status = NvDlaError_BadParameter;
+                break;
+            }
+            frame.sourceReadNs = elapsedNs(phaseStart);
+
+            phaseStart = monotonicRawNs();
+            status = prepareRawFrame(appArgs, sourceBytes, &tensorDesc,
+                                     &frame.input);
+            frame.inputPrepareNs = elapsedNs(phaseStart);
+            if (status != NvDlaSuccess)
+                break;
+
+            std::unique_lock<std::mutex> lock(queue->mutex);
+            queue->writable.wait(lock, [queue] {
+                return queue->frames.size() < 2 || queue->stopped;
+            });
+            if (queue->stopped)
+                break;
+            queue->frames.push_back(frame);
+            lock.unlock();
+            queue->readable.notify_one();
+        }
+        fclose(input);
+    }
+    else
+    {
+        status = NvDlaError_BadParameter;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(queue->mutex);
+        queue->status = status;
+        queue->finished = true;
+    }
+    queue->readable.notify_all();
+}
