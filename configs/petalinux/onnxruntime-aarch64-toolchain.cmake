set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED ENV{SDKTARGETSYSROOT} OR NOT DEFINED ENV{TARGET_PREFIX})
  message(FATAL_ERROR "Source the PetaLinux SDK environment before configuring")
endif()

set(CMAKE_SYSROOT "$ENV{SDKTARGETSYSROOT}")
set(CMAKE_C_COMPILER "$ENV{TARGET_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "$ENV{TARGET_PREFIX}g++")
set(CMAKE_AR "$ENV{TARGET_PREFIX}ar")
set(CMAKE_NM "$ENV{TARGET_PREFIX}nm")
set(CMAKE_RANLIB "$ENV{TARGET_PREFIX}ranlib")
set(CMAKE_STRIP "$ENV{TARGET_PREFIX}strip")

set(CMAKE_C_FLAGS_INIT "$ENV{CFLAGS} $ENV{ONNXRUNTIME_PREFIX_MAP_FLAGS} -g0 -mcpu=cortex-a53 -march=armv8-a+crc")
set(CMAKE_CXX_FLAGS_INIT "$ENV{CXXFLAGS} $ENV{ONNXRUNTIME_PREFIX_MAP_FLAGS} -g0 -mcpu=cortex-a53 -march=armv8-a+crc")
set(CMAKE_EXE_LINKER_FLAGS_INIT "$ENV{LDFLAGS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "$ENV{LDFLAGS}")

set(CMAKE_FIND_ROOT_PATH "$ENV{SDKTARGETSYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
